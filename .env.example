# ── Kadam AI / YouPath — GROQ (рекомендуется, как в скрипте) ──
# Ключ console.groq.com/keys. Быстро и умно (llama-3.3-70b). ⚠️ виден в браузере — для теста.
# VITE_GROQ_KEY=gsk_xxx
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ── Kadam AI — БЫСТРЫЙ старт (без деплоя функций) ──
# Токен huggingface.co/settings/tokens. ⚠️ виден в браузере — бери лимитированный/бесплатный,
# для прода используй прокси (VITE_PROFORI_ENDPOINT ниже). Оживляет ЭССЕ, ПРОФОРИЕНТАЦИЮ,
# генерацию тестов и AI-подбор вузов.
# VITE_HF_TOKEN=hf_xxx
# VITE_HF_MODEL=NousResearch/Hermes-4-70B   # можно сменить на другую умную модель

# ── AI-профориентация (опционально) ──
# Прокси к Hermes 4 (см. MODEL.md). Пусто = локальный движок без AI.
# VITE_PROFORI_ENDPOINT=https://your-domain/api/profori

# ── Бэкенд Supabase (опционально) ──
# Пусто = данные в localStorage браузера. Задай ключи проекта, чтобы включить БД.
# Схема: supabase/qadam-schema.sql (запусти в SQL Editor).
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>

# ── Поиск новых программ (Tavily, опционально) ──
# URL Edge Function supabase/functions/qadam-discover (секрет TAVILY_API_KEY — на сервере).
# VITE_TAVILY_ENDPOINT=https://<ref>.functions.supabase.co/qadam-discover

# ── Админ-модерация (Edge Function на service-ключе) ──
# Нужна, чтобы админка видела pending и меняла статусы при включённой БД.
# Деплой supabase/functions/qadam-admin + секрет ADMIN_SECRET.
# VITE_ADMIN_ENDPOINT=https://<ref>.functions.supabase.co/qadam-admin

# ── Оплата (Stripe/Kaspi, опционально) ──
# Edge Function supabase/functions/qadam-pay (секрет STRIPE_SECRET_KEY).
# Без него Pricing разблокирует тариф в демо-режиме.
# VITE_PAY_ENDPOINT=https://<ref>.functions.supabase.co/qadam-pay
